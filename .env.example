# Env for amt-asset-mcp. No dotenv — the MCP client's config supplies these (see .mcp.json
# "env" block). This file is documentation, never real values.

# Read by .mcp.json from your shell. Export these in your shell profile, not in this repo.
# Required: the tenant this server is locked to.
AMT_TENANT_ID=tenant-id-here
# Optional: this is the default. Role from db/readonly-role.sql; local trust auth needs no password.
AMT_MCP_DB_URL=postgresql://amt_mcp_ro@localhost:5432/amt_saas

# What the server itself reads. .mcp.json fills these in, so set them by hand only for
# npm run check:tools.
DATABASE_URL=postgresql://amt_mcp_ro@localhost:5432/amt_saas
TENANT_ID=tenant-id-here

# For npm run check:tools only: a real tenant with no assets.
OTHER_TENANT_ID=empty-tenant-id-here
