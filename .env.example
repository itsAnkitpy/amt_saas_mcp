# Required env for amt-asset-mcp. No dotenv — the MCP client's config supplies
# these (see .mcp.json "env" block). This file is documentation, never real values.

# Read-only Postgres role against the LOCAL dev DB only (module 02)
DATABASE_URL=postgresql://readonly_user:CHANGE_ME@localhost:5432/amt_saas_dev

# Tenant scope, fixed at server launch — never a tool argument (module 04)
TENANT_ID=dev-tenant-id-here
